              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 invalid signature', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().detail).to.match(/signature/i);",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.collectionVariables.get('token');",
                  "const last = t.slice(-1) === 'A' ? 'B' : 'A';",
                  "pm.collectionVariables.set('forgedToken', t.slice(0, -1) + last);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
