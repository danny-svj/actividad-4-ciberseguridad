        {
          "name": "2.3 Token forjado alg:none",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 invalid_token (alg none rechazado)', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error).to.eql('invalid_token');",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Construye un token con alg \"none\", rol admin y sin firma a partir del token valido",
                  "const b64url = (s) => CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(s)).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "const decode = (p) => CryptoJS.enc.Base64.parse(p.replace(/-/g, '+').replace(/_/g, '/')).toString(CryptoJS.enc.Utf8);",
                  "const parts = (pm.collectionVariables.get('token') || 'e30.e30.x').split('.');",
                  "const payload = JSON.parse(decode(parts[1]) || '{}');",
                  "payload.scope = 'products:read products:write admin';",
                  "payload.role = 'admin';",
                  "pm.collectionVariables.set('forgedToken', b64url(JSON.stringify({ alg: 'none', typ: 'JWT' })) + '.' + b64url(JSON.stringify(payload)) + '.');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{forgedToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            }
          }
        },
