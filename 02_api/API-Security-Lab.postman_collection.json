    {
      "name": "4. Rate limiting (ejecutar con 105 iteraciones)",
      "item": [
        {
          "name": "4.1 GET repetido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const i = pm.info.iteration; // 0-based",
                  "pm.test('Iteracion ' + (i + 1) + ': codigo esperado', () => {",
                  "  if (i < 100) {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 429]); // 429 solo si hubo trafico previo en la misma ventana",
                  "  } else {",
                  "    pm.response.to.have.status(429);",
                  "  }",
                  "});",
                  "if (pm.response.code === 429) {",
                  "  pm.test('429 incluye cabecera RateLimit y mensaje', () => {",
                  "    pm.expect(pm.response.json().error).to.eql('too_many_requests');",
                  "    pm.expect(pm.response.headers.has('RateLimit') || pm.response.headers.has('RateLimit-Policy')).to.be.true;",
                  "  });",
                  "}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Si la carpeta se ejecuta sola, obtiene un token una vez (el endpoint /oauth/token no cuenta en el limite)",
                  "if (!pm.collectionVariables.get('token')) {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/oauth/token',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
                  "    body: { mode: 'urlencoded', urlencoded: [",
                  "      { key: 'grant_type', value: 'client_credentials' },",
                  "      { key: 'client_id', value: pm.collectionVariables.get('clientId') },",
                  "      { key: 'client_secret', value: pm.collectionVariables.get('clientSecret') }",
                  "    ] }",
                  "  }, (err, res) => { if (!err) pm.collectionVariables.set('token', res.json().access_token); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            }
          }
        }
